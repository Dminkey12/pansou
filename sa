quality:
  - name: 默认配置-权重映射
    id: default-weight-mapping
    min_score_diff: 10

    scoring:
      # 1. 分辨率 (权重: 10)
      resolution:
        enabled: true
        unknown_policy: ignore
        weight: 10
        priority:
          - value: 4320p
            score: 10.00
          - value: 2160p
            score: 9.50
          - value: 1080p
            score: 7.00
          - value: 720p
            score: 4.00
          - value: 576p
            score: 2.50
          - value: 480p
            score: 2.00
          - value: 360p
            score: 1.00

      # 2. 片源类型 (权重: 2)
      source:
        enabled: true
        unknown_policy: ignore
        weight: 2
        priority:
          - value: Ultra HD
            score: 10.00
          - value: Blu-Ray
            score: 9.50
          - value: Remux
            score: 9.00
          - value: WEB-DL
            score: 8.50

      # 3. 视频编码 (权重: 7)
      video_codec:
        enabled: true
        unknown_policy: ignore
        weight: 7
        priority:
          - value: AV1
            score: 10.00
          - value: H.264
            score: 9.50
          - value: H.265
            score: 9.00

      # 4. 音轨 (权重: 4) - 通过列表顺序决定优先级
      audio_codec:
        enabled: true
        unknown_policy: ignore
        required: false
        weight: 4
        priority:
          - codecs: [DTS:X]
          - codecs: [Dolby TrueHD]
            atmos: true
            min_channels: 7
          - codecs: [Dolby TrueHD]
            atmos: true
            min_channels: 5
          - codecs: [DTS-HD MA]
            min_channels: 7
          - codecs: [DTS-HD MA]
            min_channels: 5
          - codecs: [Dolby TrueHD]
            min_channels: 7
          - codecs: [Dolby TrueHD]
            min_channels: 5
          - codecs: [DTS-HD]
          - codecs: [Dolby Digital Plus]
            atmos: true
            min_channels: 5
          - codecs: [Dolby Digital Plus]
            min_channels: 5
          - codecs: [DTS]
          - codecs: [PCM]
          - codecs: [Dolby Digital, DDP]
          - codecs: [AC3]
          - codecs: [AAC]

      # 5. 动态范围/HDR (权重: 7)
      hdr:
        enabled: true
        unknown_policy: ignore
        weight: 7
        priority:
          - value: Dolby Vision P7
            score: 10.00
          - value: Dolby Vision P5
            score: 9.80
          - value: Dolby Vision P8
            score: 9.50
          - value: Dolby Vision
            score: 9.00
          - value: HDR10+
            score: 8.50
          - value: HDR10
            score: 7.50
          - value: HDR
            score: 7.00
          - value: HLG
            score: 6.50
          - value: SDR
            score: 6.00

      # 6. 色深 (权重: 7)
      color_depth:
        enabled: true
        unknown_policy: ignore
        weight: 7
        priority:
          - value: 12-bit
            score: 10.00
          - value: 10-bit
            score: 9.50
          - value: 8-bit
            score: 9.00

      # 7. 帧率 (权重: 5.5)
      frame_rate:
        enabled: true
        unknown_policy: ignore
        weight: 5.5
        priority:
          - value: 120fps
            score: 10.00
          - value: 60fps
            score: 9.50
          - value: 30fps
            score: 9.00
          - value: 25fps
            score: 8.50
          - value: 24fps
            score: 8.00

      # 8. 字幕 (权重: 3) - 必需，且只偏好中文
      subtitle:
        enabled: true
        unknown_policy: ignore
        required: true
        weight: 3
        priority:
          - languages: [zh, zh-CN, zh-TW, zh-HK, yue]
            source: embedded

      # 9. 文件扩展名 (权重: 2)
      file_extension:
        enabled: true
        unknown_policy: ignore
        weight: 2
        priority:
          - value: .mkv
            score: 10.00
          - value: .mp4
            score: 9.00
          - value: .ts
            score: 8.00
          - value: .m2ts
            score: 7.00
          - value: .iso
            score: 6.00
          - value: .avi
            score: 5.00
          - value: .rmvb
            score: 4.00
          - value: .wmv
            score: 3.00
          - value: .mpeg
            score: 2.50
          - value: .mov
            score: 2.00

      # 10. 文件大小 (权重: 0, 即关闭)
      file_size:
        enabled: false
        weight: 0

      # 11. 视频码率 (关闭)
      video_bitrate:
        enabled: false
        weight: 0

      # 12. 容器总码率 (关闭)
      bitrate:
        enabled: false
        weight: 0

    # 排除规则
    exclude:
      resolutions: [360p]
      codecs: [Xvid, DivX]
      hdr_types: []

    # 单版本模式 (关闭)
    version:
      enabled: false
